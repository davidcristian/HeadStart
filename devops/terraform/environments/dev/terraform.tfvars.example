# Copy to terraform.tfvars (gitignored) OR provide via environment variables:
#   export TF_VAR_db_password=...
#   export TF_VAR_jwt_secret=...
#   export TF_VAR_credentials_secret_key=...
#
# Do NOT commit real secrets.

region    = "us-east-2"
image_tag = "latest"

# Secrets (prefer environment variables over this file).
db_password            = "change-me-strong-password"
jwt_secret             = "change-me-long-random-jwt-secret"
credentials_secret_key = "change-me-long-random-credentials-key"

# Optional: lock CORS to your real domain once you have one.
# domain_name     = "jobs.example.com"
# route53_zone_id = "Z0123456789ABCDEFGHIJ"
# cors_origins = ["https://jobs.example.com"]

ntfy_default_topic = "jobnotifier-change-me"
