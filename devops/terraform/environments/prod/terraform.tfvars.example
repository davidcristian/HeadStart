# Non-secret knobs may live in a local terraform.tfvars (gitignored).
# Core secrets MUST stay in the shell as TF_VAR_*. Never paste them into
# terraform.tfvars. A copied file with real secrets is an easy leak
# if force-added or backed up outside git.
#
#   export TF_VAR_db_password="$(openssl rand -base64 24)"
#   export TF_VAR_jwt_secret="$(openssl rand -hex 32)"
#   export TF_VAR_credentials_secret_key="$(openssl rand -hex 32)"

region = "us-east-2"
# Required: pin the AWS account this env may target. Terraform rejects
# non-12-digit values; wrong ambient credentials then fail at provider init:
#   export TF_VAR_aws_account_id="$(aws sts get-caller-identity --query Account --output text)"
# aws_account_id = "123456789012"

# Required: immutable pin (git SHA). Terraform rejects empty / "latest".
# Prefer TF_VAR_image_tag from the shell so the pin matches the just-built image:
#   export TF_VAR_image_tag="$(git rev-parse --short HEAD)"
image_tag = "REPLACE_WITH_GIT_SHA"

# Required in prod: HTTPS so the ALB does not serve auth traffic over
# plaintext HTTP. Either domain_name + route53_zone_id (auto ACM)
# or set acm_certificate_arn instead.
domain_name     = "jobs.example.com"
route53_zone_id = "Z0123456789ABCDEFGHIJ"
# acm_certificate_arn = "arn:aws:acm:us-east-2:123456789012:certificate/..."
# cors_origins defaults to https://jobs.example.com when domain_name is set.
# cors_origins = ["https://jobs.example.com"]

# Transactional email (password reset + email notifier). smtp_from defaults to
# noreply@jobs.example.com when smtp_host is set and smtp_from is omitted.
# smtp_host     = "email-smtp.us-east-2.amazonaws.com"
# smtp_user     = "..."
# smtp_password = "..."   # prefer TF_VAR_smtp_password in the shell

# Required: ntfy.sh topics are public by name. Set via TF_VAR or uncomment and
# replace with your own unguessable value (terraform rejects change-me placeholders):
#   export TF_VAR_ntfy_default_topic="jobs-$(openssl rand -hex 8)"
# ntfy_default_topic = "jobs-a1b2c3d4e5f67890"

# Optional: ECS LOG_LEVEL (default INFO). Raise for incident diagnosis:
# log_level = "DEBUG"
#   # or: export TF_VAR_log_level=DEBUG
