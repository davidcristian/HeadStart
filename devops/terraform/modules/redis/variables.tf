variable "name" { type = string }
variable "subnet_ids" { type = list(string) }
variable "security_group_id" { type = string }

variable "engine_version" {
  type    = string
  default = "7.1"
}
variable "node_type" {
  type    = string
  default = "cache.t4g.micro"
}
variable "parameter_group_name" {
  type    = string
  default = "default.redis7"
}

# When true, provision Multi-AZ with automatic failover (OPS-05 / OPS-49).
variable "automatic_failover" {
  type        = bool
  default     = false
  description = "Use Multi-AZ automatic failover (requires at least 2 cache clusters)."
}

variable "num_cache_clusters" {
  type        = number
  default     = 1
  description = "Nodes in the replication group (1 for beta; >=2 when automatic_failover)."

  validation {
    condition     = var.num_cache_clusters >= 1
    error_message = "num_cache_clusters must be at least 1."
  }
}

# AUTH token for Redis (16–128 printable ASCII, no / @ "). Generated by the
# stack and stored in Secrets Manager as REDIS_PASSWORD (OPS-10).
variable "auth_token" {
  type        = string
  sensitive   = true
  description = "ElastiCache AUTH token; requires transit_encryption_enabled."

  validation {
    condition     = length(var.auth_token) >= 16 && length(var.auth_token) <= 128
    error_message = "auth_token must be 16–128 characters (ElastiCache requirement)."
  }
}

# Optional customer-managed KMS key for at-rest encryption. Empty uses the
# AWS-managed ElastiCache key (alias/aws/elasticache).
variable "kms_key_id" {
  type        = string
  default     = ""
  description = "Optional CMK ARN/id for at-rest encryption; empty = AWS-managed."
}

variable "tags" {
  type    = map(string)
  default = {}
}
