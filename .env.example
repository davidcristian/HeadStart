# Copy to .env for local development: cp .env.example .env
# These values are wired into docker-compose.yml and the backend settings.

# ---- General ----
ENVIRONMENT=local
LOG_LEVEL=INFO
# json (default) for field queries in CloudWatch/Loki; text for local grepping.
LOG_FORMAT=json

# ---- API ----
# Comma-separated CORS origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
# Comma-separated CIDRs of reverse proxies allowed to set X-Forwarded-For.
# Empty (default) ignores XFF and uses the TCP peer — required so clients cannot
# forge GDPR/audit IPs (AUT-17). Behind an ALB/nginx, set the proxy/VPC CIDR
# (Terraform sets this to vpc_cidr on ECS). Local TestClient needs no value.
# TRUSTED_PROXY_CIDRS=10.0.0.0/16

# ---- Auth (JWT) ----
# Secret used to sign access/refresh JWTs. Change this to a long random value;
# keep it stable so existing sessions survive restarts.
JWT_SECRET=dev-local-jwt-secret-change-me-to-a-long-random-value
# JWT signing algorithm (HS256 by default).
JWT_ALGORITHM=HS256
# Access token lifetime (minutes) and refresh token lifetime (days).
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# RSS feed JWT lifetime (days). Feed URLs carry ?token=; keep bounded and rotate
# via POST /feed/rotate when a link may have leaked (AUT-22).
FEED_TOKEN_EXPIRE_DAYS=90
# Password-reset link lifetime (minutes) and web UI base URL for reset emails.
# On AWS, Terraform sets FRONTEND_BASE_URL from app_url when a custom domain is configured.
PASSWORD_RESET_EXPIRE_MINUTES=60
EMAIL_VERIFICATION_EXPIRE_MINUTES=1440
FRONTEND_BASE_URL=http://localhost:5173

# Refresh-token cookie. The refresh token is delivered as an httpOnly cookie
# (never readable by JS) scoped to the auth routes. Defaults are production-safe
# (Secure + SameSite=Lax, for a same-origin deploy behind nginx). For local dev
# over plain HTTP, set AUTH_COOKIE_SECURE=false so the browser stores/sends it.
# Outside local/test, AUTH_COOKIE_SECURE=true requires https FRONTEND_BASE_URL,
# and SameSite=none requires AUTH_COOKIE_SECURE=true (AUT-13).
AUTH_COOKIE_NAME=headstart_refresh
AUTH_COOKIE_PATH=/api/v1/auth
AUTH_COOKIE_SECURE=true
# One of: lax | strict | none  (use "none" + Secure only for cross-site setups).
AUTH_COOKIE_SAMESITE=lax

# ---- Email (password reset + verification) ----
# Leave SMTP_HOST empty in local/test only; reset/verify links are logged instead.
# Outside local/test, SMTP_HOST is required at startup (tokens must not hit logs).
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@example.com
# SMTP_USE_TLS=true

# ---- Credential encryption ----
# Encrypts per-site credentials (cookies/headers/session) at rest. Stretched via
# scrypt into a Fernet key (see backend/app/core/crypto.py). Use a long random
# value (>= 32 chars outside local/test); prefer:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# To rotate without bricking ciphertext, keep the old value as:
# CREDENTIALS_SECRET_KEY_PREVIOUS=...
CREDENTIALS_SECRET_KEY=dev-local-credentials-key-change-me
# CREDENTIALS_SECRET_KEY_PREVIOUS=

# Max resume file size for application-profile uploads (bytes; default 2 MB).
PROFILE_RESUME_MAX_BYTES=2097152
PROFILE_RESUME_TEMPLATE_MAX_BYTES=524288
PROFILE_RESUME_TEMPLATE_BUNDLE_MAX_BYTES=2097152

# ---- Database (Postgres) ----
POSTGRES_USER=headstart
# Required by docker-compose (OPS-58); compose refuses to start without it.
POSTGRES_PASSWORD=headstart
POSTGRES_DB=headstart
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Full SQLAlchemy URL is derived from the parts above by the backend settings,
# but can be overridden explicitly here if desired.
# DATABASE_URL=postgresql+psycopg://headstart:headstart@db:5432/headstart

# ---- Redis (Celery broker + result backend) ----
REDIS_HOST=redis
REDIS_PORT=6379
# ElastiCache AUTH + TLS (leave unset for local docker Redis).
# REDIS_PASSWORD=
# REDIS_TLS=false
# CELERY_BROKER_URL=redis://redis:6379/0
# CELERY_RESULT_BACKEND=redis://redis:6379/1

# ---- Scheduler ----
# How often Celery beat checks for due searches (seconds).
SCHEDULER_TICK_SECONDS=30

# ---- Playwright (worker / opt-in scraper) ----
# Navigation timeout for the playwright adapter (milliseconds).
PLAYWRIGHT_NAVIGATION_TIMEOUT_MS=30000
# Retries after the first navigation attempt (0 = no retries).
PLAYWRIGHT_MAX_RETRIES=1
# OPS-27: keep Chromium's process sandbox (default false). local/test-only escape
# hatch when a constrained host cannot run the sandbox; rejected outside local/test.
# PLAYWRIGHT_NO_SANDBOX=false
# Max bytes for a single scraper/applier HTTP response body (default 5 MiB).
SCRAPER_MAX_RESPONSE_BYTES=5242880

# ---- Metrics (Prometheus) ----
METRICS_ENABLED=true
# Worker-only port for GET /metrics when the pipeline runs in Celery.
METRICS_PORT=9090
# Optional bearer token for GET /metrics (leave empty for local dev).
# METRICS_TOKEN=

# ---- AI summaries ("why this matches" blurb in notifications) ----
# Adds a short blurb to each new-job notification and to the Jobs feed.
SUMMARIES_ENABLED=true
# Provider: "heuristic" (offline, free, default), "openai", "gemini", "anthropic", or "llamacpp" (local dev).
SUMMARY_PROVIDER=heuristic
# Max characters kept from a generated blurb.
SUMMARY_MAX_CHARS=280

# ---- AI cover letters (apply dialog; Pro users reuse SUMMARY_PROVIDER) ----
COVER_LETTERS_ENABLED=true
COVER_LETTER_MAX_CHARS=4000
COVER_LETTER_MAX_TOKENS=900

# ---- AI resume curation (LaTeX template → tailored PDF; dev/local) ----
RESUME_CURATION_ENABLED=true
RESUME_CURATION_MAX_TOKENS=1200
RESUME_COMPILE_TIMEOUT_SECONDS=60

# ---- AI inbox email classification (dev-only inbox agent) ----
# Max chars of an email body fed to the classifier, and max output tokens.
# EMAIL_CLASSIFY_MAX_BODY_CHARS=8000
# EMAIL_CLASSIFY_MAX_TOKENS=256

# ---- AI inbox reply drafting (dev-only; dry-run, no auto-send) ----
# REPLY_DRAFTS_ENABLED=true
# EMAIL_DRAFT_MAX_CHARS=4000
# EMAIL_DRAFT_MAX_TOKENS=600

# ---- OpenAI (only used when SUMMARY_PROVIDER=openai) ----
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# ---- Gemini (only used when SUMMARY_PROVIDER=gemini) ----
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# ---- Anthropic (only used when SUMMARY_PROVIDER=anthropic) ----
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-haiku-latest
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
# ANTHROPIC_API_VERSION=2023-06-01

# ---- llama.cpp (only used when SUMMARY_PROVIDER=llamacpp; local dev) ----
# LLAMACPP_BASE_URL=http://localhost:8080/v1
# LLAMACPP_MODEL=local
# LLAMACPP_API_KEY=
# make llamacpp helper only (not read by the backend):
# LLAMACPP_MODEL_PATH=/path/to/model.gguf
# LLAMACPP_FLASH_ATTN=on
# LLAMACPP_CTX_SIZE=2048
# LLAMACPP_NGL=99

# ---- Inbox agent (dev-only; Phase 20c mailbox connector) ----
# Leave INBOX_AGENT_ENABLED=false on hosted multi-tenant production.
# INBOX_AGENT_ENABLED=false
# Single-user local dev: share one mailbox via env when no per-user credential is saved.
# INBOX_USE_ENV_CREDENTIALS=false
# INBOX_IMAP_HOST=
# INBOX_IMAP_PORT=993
# INBOX_IMAP_USE_SSL=true
# INBOX_IMAP_USER=
# INBOX_IMAP_PASSWORD=
# INBOX_IMAP_MAILBOX=INBOX
# INBOX_SMTP_HOST=
# INBOX_SMTP_PORT=587
# INBOX_SMTP_USE_TLS=true
# INBOX_SMTP_USER=
# INBOX_SMTP_PASSWORD=
# INBOX_SMTP_FROM=
# Gmail OAuth (optional; enables Settings → Connect Gmail)
# GMAIL_OAUTH_CLIENT_ID=
# GMAIL_OAUTH_CLIENT_SECRET=
# GMAIL_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/inbox/gmail/callback
# Outlook OAuth (optional; enables Settings → Connect Outlook)
# OUTLOOK_OAUTH_CLIENT_ID=
# OUTLOOK_OAUTH_CLIENT_SECRET=
# OUTLOOK_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/inbox/outlook/callback
# Yahoo OAuth (dev-only inbox connector; optional)
# YAHOO_OAUTH_CLIENT_ID=
# YAHOO_OAUTH_CLIENT_SECRET=
# YAHOO_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/inbox/yahoo/callback
# Days without recruiter reply before ghost detection emails a self-summary (default 14).
# INBOX_GHOST_WINDOW_DAYS=14
# How often beat checks for stale applications in seconds (default 3600).
# INBOX_GHOST_CHECK_INTERVAL_SECONDS=3600
# How often beat polls mailboxes for new messages in seconds (default 300).
# INBOX_POLL_INTERVAL_SECONDS=300
# Max messages to fetch and classify per user per poll tick (default 50).
# INBOX_POLL_BATCH_SIZE=50
# Minimum delay before auto-sent recruiter replies (seconds; never below 60).
# INBOX_REPLY_MIN_DELAY_SECONDS=1800
# Random extra delay on top of the minimum (seconds).
# INBOX_REPLY_DELAY_JITTER_SECONDS=900
# How often beat processes due pending auto-replies (seconds).
# INBOX_REPLY_SEND_INTERVAL_SECONDS=60
# Max autonomous recruiter replies per user per hour/day (0 = unlimited).
# INBOX_REPLY_MAX_PER_HOUR=10
# INBOX_REPLY_MAX_PER_DAY=30

# ---- ntfy defaults (used to seed a default notification target) ----
NTFY_DEFAULT_SERVER_URL=https://ntfy.sh
# Pick something unguessable (≥16 chars); subscribe to it in the ntfy app on your phone.
# Non-local ENVIRONMENT rejects this placeholder, "change-me", and short topics (OPS-16/NTF-06).
# `just seed` also replaces a guessable value with a random jobs-<hex> topic for the demo target.
NTFY_DEFAULT_TOPIC=headstart-change-me

# ---- Seed demo account (owns the example source/target/search from `make seed`) ----
# Log in with these in the UI after seeding, then change the password.
SEED_USER_EMAIL=demo@example.com
SEED_USER_PASSWORD=demo-password-change-me

# ---- Stripe billing (optional; leave empty to disable paid checkout) ----
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_STARTER_MONTHLY=price_...
# STRIPE_PRICE_STARTER_ANNUAL=price_...
# STRIPE_PRICE_PLUS_MONTHLY=price_...
# STRIPE_PRICE_PLUS_ANNUAL=price_...
# STRIPE_PRICE_PRO_MONTHLY=price_...
# STRIPE_PRICE_PRO_ANNUAL=price_...
# STRIPE_TRIAL_DAYS=14

# ---- Free-tier ads (optional) ----
# ADS_ENABLED=false hides all in-app ads (built-in upgrade card + external slot).
# ADS_EXTERNAL_SLOT_URL=https://example.com/ad-slot.html

# ---- Frontend ----
# Base URL the browser uses to reach the API.
VITE_API_BASE_URL=http://localhost:8000
